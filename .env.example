# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service Role Key (Required for auto-seeding super admin)
# ⚠️ NEVER commit this to version control or expose it in client-side code
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Node Environment
NODE_ENV=development

# Auto-seed super admin on app startup
# Set to 'true' to enable (default: enabled in development)
AUTO_SEED=true
